# Travel to the Imperial Islands
print("\nFlight or Cruise")

travel = input(f"How do you want to reach the Imperial Islands from {place}? ").lower()

if travel == 'flight' or travel == 'f':
    print("Great! You are near the airport exit of the Imperial Islands now.")
elif travel == 'cruise' or travel == 'c':
    print("Great! You are near the port exit of the Imperial Islands now.")
else:
    print("Aliens kidnapped you! Try again!")
    exit()


# From the exit - fd = First Decision
fd = input("\nWhich direction do you want to go, left or right from the exit? ").lower()

if fd == 'right' or fd == 'r':
    print("Great! You find an abandoned ice-cream shop and enter it.")
elif fd == 'left' or fd == 'l':
    print("Ohh no! Zombies attacked you! Try again!")
    exit()
else:
    print("Aliens kidnapped you! Try again!")
    exit()


